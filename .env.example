# Terraform sets these as app settings on the function app; this file is only for running
# the API on your own machine. Everything except MANAGED_IDENTITY_CLIENT_ID is required.

# Entra ID app registration that protects this API. ENTRA_API_CLIENT_ID is the audience of
# the tokens the API accepts, and is not AZURE_CLIENT_ID on purpose: the Azure SDK reads
# that name as the managed identity to authenticate as.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Subscription the VNets are created in, and where the results are stored
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
STORAGE_ACCOUNT_NAME=stazvnetapiexample
TABLE_NAME=vnetcreations

# Which user-assigned identity to use. Leave blank locally: the credential chain then
# falls through to your Azure CLI login.
MANAGED_IDENTITY_CLIENT_ID=
